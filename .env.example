# Copy to .env for local dev. Set the same vars in Vercel → Project → Settings → Environment Variables.

# Contact form (existing)
EMAIL_USER=piccomessages@gmail.com
EMAIL_PASS=your-gmail-app-password

# Booking — your Calendly event link (shown on /contact). Until set, a placeholder is used.
VITE_CALENDLY_URL=https://calendly.com/your-account/intro-call

# Admin page (/admin) password
ADMIN_PASSWORD=choose-a-strong-password

# Vercel Cron auth for /api/cron/refresh-tokens (any long random string;
# Vercel automatically sends it as a Bearer token when this env var exists)
CRON_SECRET=any-long-random-string

# Meta app secret (from developers.facebook.com → your app → App settings → Basic).
# Lets /admin upgrade pasted short-lived Instagram tokens to 60-day tokens.
IG_APP_SECRET=your-meta-app-secret

# Upstash Redis — auto-provisioned by the Vercel Marketplace integration
# (either naming works; pull locally with `vercel env pull`)
KV_REST_API_URL=
KV_REST_API_TOKEN=
